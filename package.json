{
  "name": "ece-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:search-index && npm run build:calendar-events && cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "build": "npm run build:search-index && npm run build:calendar-events && next build",
    "build:search-index": "node scripts/build-search-index.mjs",
    "build:calendar-events": "node scripts/build-calendar-events.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "next": "^16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
